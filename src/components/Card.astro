---
// Card component — flat, border, no shadow
// Per design.md §5: background matches parent section
// Usage: <Card style="--card-bg: var(--color-bg-alt)"> for alternate bg
---

<div class="card">
  <slot />
</div>

<style>
  .card {
    background: var(--card-bg, var(--color-bg));
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: var(--space-4);
  }
</style>
