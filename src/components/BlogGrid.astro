---
// Blog grid — latest 3 posts from the blog content collection
// Per design.md §6 (bg-default), §5 (card with section bg), HOMEPAGE_SPEC.md §6
// IMPORTANT: implements as Astro Content Collection, not hardcoded markup
import { getCollection } from 'astro:content';
import Card from './Card.astro';
import Link from './Link.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section class="blog-section bg-default">
  <div class="blog-container">
    <h2 class="blog-title">Latest from 99Ways Academy</h2>
    <div class="blog-grid">
      {posts.map(post => (
        <Card style="--card-bg: var(--color-bg);">
          <span class="blog-category">{post.data.category}</span>
          <h3 class="blog-card-title">
            <a href={post.data.url}>{post.data.title}</a>
          </h3>
          <p class="blog-excerpt">{post.data.excerpt}</p>
        </Card>
      ))}
    </div>
    <a href="/academy/" class="blog-view-all">View all posts</a>
  </div>
</section>

<style>
  .blog-section {
    padding-block: var(--space-8);
  }

  .blog-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .blog-title {
    font-family: var(--font-primary);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: var(--text-h2);
    line-height: 1.2;
    color: var(--color-text);
    margin: 0 0 var(--space-8);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .blog-card-title {
    font-family: var(--font-primary);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: var(--text-h3);
    line-height: 1.3;
    color: var(--color-text);
    margin: var(--space-2) 0 var(--space-3);
  }

  .blog-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .blog-card-title a:hover {
    color: var(--color-accent);
  }

  .blog-excerpt {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-category {
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: var(--text-label);
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--color-accent);
    display: block;
  }

  .blog-view-all {
    display: inline-block;
    margin-top: var(--space-6);
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: var(--text-label);
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .blog-view-all:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-section {
      padding-block: var(--space-16);
    }

    .blog-container {
      padding-inline: var(--space-12);
    }

    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
