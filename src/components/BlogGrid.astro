---
// Blog grid — latest 3 posts from the blog content collection
// Per design.md §6 (bg-default), §5 (card with section bg), HOMEPAGE_SPEC.md §6
// IMPORTANT: implements as Astro Content Collection, not hardcoded markup
import { getCollection } from 'astro:content';
import Card from './Card.astro';
import Link from './Link.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const categoryArchiveUrl = (category: string) => {
  const slug = category.toLowerCase().replace(/\s+/g, '-');
  return `/category/${slug}/`;
};

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<section class="blog-section bg-default">
  <div class="blog-container">
    <h2 class="blog-title">Latest from 99Ways Academy</h2>
    <div class="blog-grid">
      {posts.map(post => (
        <Card style="--card-bg: var(--color-bg);">
          {post.data.image && (
            <div class="blog-card-image-wrapper">
              <img
                src={post.data.image}
                alt={post.data.title}
                loading="lazy"
                class="blog-card-image"
              />
            </div>
          )}
          <a href={categoryArchiveUrl(post.data.category)} class="blog-category">{post.data.category}</a>
          <h3 class="blog-card-title">
            <a href={post.data.url}>{post.data.title}</a>
          </h3>
          <p class="blog-meta">
            By {post.data.authorName} • {formatDate(post.data.date)} • {post.data.commentCount} Comments
          </p>
          <p class="blog-excerpt">{post.data.excerpt}</p>
        </Card>
      ))}
    </div>
    <a href="/academy/" class="blog-view-all">
      <svg class="view-all-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M5.25 2.75L9.75 7L5.25 11.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      View all posts
    </a>
  </div>
</section>

<style>
  .blog-section {
    padding-block: var(--space-8);
  }

  .blog-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .blog-title {
    font-family: var(--font-primary);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: var(--text-h2);
    line-height: 1.2;
    color: var(--color-text);
    margin: 0 0 var(--space-8);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .blog-card-title {
    font-family: var(--font-primary);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: var(--text-h3);
    line-height: 1.3;
    color: var(--color-text);
    margin: var(--space-2) 0 var(--space-3);
  }

  .blog-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .blog-card-title a:hover {
    color: var(--color-accent);
  }

  .blog-excerpt {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-category {
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: var(--text-label);
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--color-accent);
    display: block;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .blog-category:hover {
    opacity: 0.8;
  }

  .blog-card-image-wrapper {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: var(--space-3);
  }

  .blog-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-meta {
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: var(--text-label);
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
  }

  .blog-view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: var(--text-label);
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .blog-view-all:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .view-all-arrow {
    display: inline-block;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 175ms ease, transform 175ms ease;
  }

  .blog-view-all:hover .view-all-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-section {
      padding-block: var(--space-16);
    }

    .blog-container {
      padding-inline: var(--space-12);
    }

    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
