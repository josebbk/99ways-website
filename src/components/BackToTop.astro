<style>
  .btt{
    position: fixed;
    right: var(--space-6);
    bottom: var(--space-6);
    width: 56px;
    height: 56px;
    z-index: 40;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    border: none;
    padding: 0;
    background: none;

    opacity: 0;
    transform: scale(0.3);
    pointer-events: none;
    transition:
      opacity .35s ease,
      transform .55s cubic-bezier(.34, 1.56, .64, 1);
  }
  .btt.is-visible{
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }
  .btt.is-returning{
    transition:
      opacity .4s ease .05s,
      transform .45s cubic-bezier(.5, 0, .75, 0) .05s;
    opacity: 0;
    transform: scale(0.3);
  }

  .btt-ring{
    position: absolute; inset: 0;
    transform: rotate(-90deg);
    overflow: visible;
  }
  .btt-ring circle{
    fill: none;
    stroke-width: 2.5;
  }
  .btt-ring .track{
    stroke: color-mix(in srgb, var(--color-accent) 18%, transparent);
  }
  .btt-ring .progress{
    stroke: var(--color-accent);
    stroke-linecap: round;
    transition: stroke-dashoffset .12s linear, stroke .3s ease;
  }

  .btt-core{
    position: absolute; inset: 4px;
    border-radius: 50%;
    background: var(--color-bg);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 16px color-mix(in srgb, black 28%, transparent), inset 0 0 0 1px var(--color-border-strong);
    transition: background .25s ease, transform .18s ease, box-shadow .25s ease;
  }
  .btt:hover .btt-core{
    background: color-mix(in srgb, black 15%, var(--color-bg));
    transform: translateY(-1px);
    box-shadow: 0 10px 22px color-mix(in srgb, black 34%, transparent), inset 0 0 0 1px var(--color-border-strong);
  }
  .btt:active .btt-core{
    transform: translateY(0px) scale(0.94);
  }
  .btt:focus-visible .btt-core{
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .btt-arrow{
    width: 18px; height: 18px;
    stroke: var(--color-text);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    transition: transform .28s cubic-bezier(.34,1.56,.64,1);
  }
  .btt:hover .btt-arrow{ transform: translateY(-2px); }
  .btt.is-launching .btt-arrow{ animation: flick .5s ease; }
  @keyframes flick{
    0%{ transform: translateY(0); }
    35%{ transform: translateY(-6px); opacity: .4; }
    36%{ transform: translateY(6px); opacity: .4; }
    100%{ transform: translateY(0); opacity: 1; }
  }

  .btt-dot{
    position: absolute;
    top: 9px; left: 9px;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 2.5px var(--color-bg);
    transition: background .2s ease, transform .2s ease;
    transform-origin: center;
  }
  .btt:hover .btt-dot{
    background: color-mix(in srgb, white 25%, var(--color-accent));
  }

  .btt.is-winking .btt-dot{ animation: wink .42s ease; }
  @keyframes wink{
    0%{ transform: scaleY(1); }
    40%{ transform: scaleY(0.15); }
    70%{ transform: scaleY(1.15); }
    100%{ transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce){
    .btt{ transition: opacity .3s ease; transform: none !important; }
    .btt.is-visible{ transform: none; }
    .btt.is-returning{ transform: none; transition: opacity .3s ease; }
    .btt-arrow, .btt-dot{ animation: none !important; transition: none !important; }
    .btt:hover .btt-arrow{ transform: none; }
  }
</style>

<button class="btt" type="button" aria-label="Back to top">
  <svg class="btt-ring" viewBox="0 0 56 56" aria-hidden="true">
    <circle class="track" cx="28" cy="28" r="25.5"></circle>
    <circle class="progress" id="bttProgress" cx="28" cy="28" r="25.5"></circle>
  </svg>
  <span class="btt-core">
    <svg class="btt-arrow" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 19V5"></path>
      <path d="M6 11l6-6 6 6"></path>
    </svg>
  </span>
  <span class="btt-dot" aria-hidden="true"></span>
</button>

<script>
  // @ts-nocheck
  (function(){
    var btn = document.querySelector('.btt');
    if (!btn) return;
    var progressCircle = document.getElementById('bttProgress');
    if (!progressCircle) return;

    var CIRC_VAL = 2 * Math.PI * 25.5;
    var SHOW_AT = 320;
    progressCircle.style.strokeDasharray = CIRC_VAL.toFixed(2);
    progressCircle.style.strokeDashoffset = CIRC_VAL.toFixed(2);

    var visible = false;
    var ticking = false;

    function scrollPct(){
      var h = document.documentElement;
      var max = h.scrollHeight - h.clientHeight;
      return max > 0 ? Math.min(h.scrollTop / max, 1) : 0;
    }

    function update(){
      var y = window.scrollY || document.documentElement.scrollTop;
      var pct = scrollPct();

      var offset = CIRC_VAL * (1 - pct);
      progressCircle.style.strokeDashoffset = offset.toFixed(2);

      var shouldShow = y > SHOW_AT;
      if (shouldShow && !visible){
        btn.classList.remove('is-returning');
        btn.classList.add('is-visible');
        visible = true;
      } else if (!shouldShow && visible){
        btn.classList.remove('is-visible');
        visible = false;
      }
      ticking = false;
    }

    function onScroll(){
      if (!ticking){
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    update();

    btn.addEventListener('pointerenter', function(){
      btn.classList.remove('is-winking');
      void btn.offsetWidth;
      btn.classList.add('is-winking');
    });
    btn.addEventListener('animationend', function(e){
      if (e.animationName === 'wink') btn.classList.remove('is-winking');
      if (e.animationName === 'flick') btn.classList.remove('is-launching');
    });

    function goTop(){
      btn.classList.add('is-launching');
      btn.classList.add('is-returning');
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    }

    btn.addEventListener('click', goTop);
    btn.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' '){
        e.preventDefault();
        goTop();
      }
    });
  })();
</script>
