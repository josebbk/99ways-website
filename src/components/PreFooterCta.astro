---
// Pre-footer CTA — single centered column, primary button
// Between Academy blog grid and footer
// Per ARCHITECTURE.md §8 (bg-alt, section spec)

import PointerField from './PointerField.astro';

const ctaLink = '#';
const ctaLabel = 'Book Intro Call';
---

<section id="pre-footer-cta" class="prefooter bg-alt">
  <PointerField />
  <div class="prefooter-container">
    <a href={ctaLink} class="btn-primary">{ctaLabel}</a>
  </div>
</section>

<style>
  .prefooter {
    padding-block: var(--space-8);
    position: relative;
    overflow: hidden;
  }

  .prefooter-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .prefooter {
      padding-block: var(--space-16);
    }
  }
</style>
