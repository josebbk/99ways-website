---
// Testimonials Carousel — interactive 3D/focal carousel
// Replaces TestimonialsFilmstrip.astro
// Per HOMEPAGE_SPEC.md §4, design.md §5 (Carousel), §7 (Motion timing)
// 9 reviews, same order, same alt text as the original filmstrip

const TESTIMONIALS = [
  { src: '/images/testimonials/01-funnel-optimization.webp', alt: 'Client review: Funnel Optimization Assessment and Recommendations' },
  { src: '/images/testimonials/02-ecommerce-analytics-cro.webp', alt: 'Client review: E-commerce analytics, CRO, and A/B testing' },
  { src: '/images/testimonials/03-marketing-cro-consultation.webp', alt: 'Client review: Marketing and conversion rate optimization consultation' },
  { src: '/images/testimonials/04-cro-quick-job.webp', alt: 'Client review: Conversion Rate Optimization Expert quick job' },
  { src: '/images/testimonials/05-posthog-analytics.webp', alt: 'Client review: PostHog and Analytics Expert' },
  { src: '/images/testimonials/06-cro-coaching-business.webp', alt: 'Client review: Conversion Rate Optimization for Coaching Business' },
  { src: '/images/testimonials/07-cro-posthog.webp', alt: 'Client review: Conversion Rate Optimization and PostHog' },
  { src: '/images/testimonials/08-course-marketing-funnel.webp', alt: 'Client review: Course Marketing Funnel Manager' },
  { src: '/images/testimonials/09-saas-posthog-setup.webp', alt: 'Client review: SaaS Google Analytics and PostHog setup' },
];

const TOTAL = TESTIMONIALS.length;
const AUTO_INTERVAL = 5000;

function getPrev(i) { return (i - 1 + TOTAL) % TOTAL; }
function getNext(i) { return (i + 1) % TOTAL; }

const prev0 = getPrev(0);
const next0 = getNext(0);
---

<script is:client>
  let activeIdx = 0;
  let lightboxOpen = false;
  let lightboxIdx = 0;
  let hovered = false;
  let touching = false;
  let transitioning = false;
  let autoTimer = null;

  function isIdle() { return !hovered && !touching && !lightboxOpen; }
  function isLocked() { return transitioning || lightboxOpen; }

  function updateCarousel() {
    var main = document.getElementById('testimonial-carousel');
    if (!main) return;
    var prevIdx = getPrev(activeIdx);
    var nextIdx = getNext(activeIdx);

    var pc = main.querySelector('.card-prev');
    var cc = main.querySelector('.card-center');
    var nc = main.querySelector('.card-next');

    if (pc) {
      var i = pc.querySelector('.testimonial-image');
      if (i) { i.src = TESTIMONIALS[prevIdx].src; i.alt = TESTIMONIALS[prevIdx].alt; }
      pc.setAttribute('data-index', String(prevIdx));
      pc.setAttribute('aria-label', 'View testimonial: ' + TESTIMONIALS[prevIdx].alt);
      pc.className = 'card card-prev';
    }
    if (cc) {
      var i = cc.querySelector('.testimonial-image');
      if (i) { i.src = TESTIMONIALS[activeIdx].src; i.alt = TESTIMONIALS[activeIdx].alt; }
      cc.setAttribute('data-index', String(activeIdx));
      cc.setAttribute('aria-label', 'View testimonial: ' + TESTIMONIALS[activeIdx].alt);
      cc.className = 'card card-center';
    }
    if (nc) {
      var i = nc.querySelector('.testimonial-image');
      if (i) { i.src = TESTIMONIALS[nextIdx].src; i.alt = TESTIMONIALS[nextIdx].alt; }
      nc.setAttribute('data-index', String(nextIdx));
      nc.setAttribute('aria-label', 'View testimonial: ' + TESTIMONIALS[nextIdx].alt);
      nc.className = 'card card-next';
    }
  }

  function updateLightbox() {
    if (!lightboxOpen) return;
    var main = document.getElementById('testimonial-carousel');
    var carousel = main ? main.querySelector('.lightbox-carousel') : null;
    if (!carousel) return;
    var prevIdx = getPrev(lightboxIdx);
    var nextIdx = getNext(lightboxIdx);

    var pc = carousel.querySelector('.card-prev');
    var cc = carousel.querySelector('.card-center');
    var nc = carousel.querySelector('.card-next');

    if (pc) {
      var i = pc.querySelector('.testimonial-image');
      if (i) { i.src = TESTIMONIALS[prevIdx].src; i.alt = TESTIMONIALS[prevIdx].alt; }
      pc.setAttribute('data-index', String(prevIdx));
      pc.setAttribute('aria-label', 'View previous testimonial: ' + TESTIMONIALS[prevIdx].alt);
      pc.className = 'card card-prev';
    }
    if (cc) {
      var i = cc.querySelector('.testimonial-image');
      if (i) { i.src = TESTIMONIALS[lightboxIdx].src; i.alt = TESTIMONIALS[lightboxIdx].alt; }
      cc.setAttribute('data-index', String(lightboxIdx));
      cc.setAttribute('aria-label', 'View testimonial: ' + TESTIMONIALS[lightboxIdx].alt);
      cc.className = 'card card-center lightbox-center-card';
    }
    if (nc) {
      var i = nc.querySelector('.testimonial-image');
      if (i) { i.src = TESTIMONIALS[nextIdx].src; i.alt = TESTIMONIALS[nextIdx].alt; }
      nc.setAttribute('data-index', String(nextIdx));
      nc.setAttribute('aria-label', 'View next testimonial: ' + TESTIMONIALS[nextIdx].alt);
      nc.className = 'card card-next';
    }
  }

  function slideTo(newIdx) {
    if (transitioning) return;
    transitioning = true;
    activeIdx = newIdx;
    updateCarousel();
    setTimeout(function() { transitioning = false; }, 350);
  }

  function openLightbox(idx) {
    lightboxIdx = idx;
    lightboxOpen = true;
    var backdrop = document.getElementById('testimonial-lightbox');
    if (backdrop) { backdrop.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
    updateLightbox();
  }

  function closeLightbox() {
    lightboxOpen = false;
    var backdrop = document.getElementById('testimonial-lightbox');
    if (backdrop) { backdrop.style.display = 'none'; }
    document.body.style.overflow = '';
    activeIdx = lightboxIdx;
    updateCarousel();
  }

  function advance() {
    if (isLocked()) return;
    slideTo(getNext(activeIdx));
  }

  function startAutoRotate() {
    if (autoTimer) return;
    autoTimer = setInterval(advance, AUTO_INTERVAL);
  }

  function stopAutoRotate() {
    if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
  }

  // ── Init ──
  document.addEventListener('astro:after-swap', function() {
    var main = document.getElementById('testimonial-carousel');
    if (!main || main.dataset.initialized) return;
    main.dataset.initialized = 'true';

    updateCarousel();
    startAutoRotate();

    main.addEventListener('mouseenter', function() { hovered = true; stopAutoRotate(); });
    main.addEventListener('mouseleave', function() { hovered = false; if (isIdle()) startAutoRotate(); });
    main.addEventListener('touchstart', function() { touching = true; stopAutoRotate(); }, { passive: true });
    main.addEventListener('touchend', function() { touching = false; if (isIdle()) startAutoRotate(); });

    // Delegate side card clicks
    main.addEventListener('click', function(e) {
      var card = e.target.closest('.card-prev, .card-next');
      if (card) { slideTo(parseInt(card.getAttribute('data-index') || '0', 10)); }
    });
    main.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        var card = e.target.closest('.card-prev, .card-next');
        if (card) { e.preventDefault(); slideTo(parseInt(card.getAttribute('data-index') || '0', 10)); }
      }
    });

    // Center card → lightbox
    main.addEventListener('click', function(e) {
      var center = main.querySelector('.card-center');
      if (center && (e.target === center || center.contains(e.target))) {
        openLightbox(parseInt(center.getAttribute('data-index') || '0', 10));
      }
    });
    main.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        var center = main.querySelector('.card-center');
        if (center && (e.target === center || center.contains(e.target))) {
          e.preventDefault();
          openLightbox(parseInt(center.getAttribute('data-index') || '0', 10));
        }
      }
    });

    // Lightbox
    var backdrop = document.getElementById('testimonial-lightbox');
    if (backdrop) {
      backdrop.addEventListener('click', function(e) {
        if (e.target === backdrop) closeLightbox();
      });
      var closeBtn = document.getElementById('lightbox-close-btn');
      if (closeBtn) {
        closeBtn.addEventListener('click', closeLightbox);
        closeBtn.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); closeLightbox(); }
        });
      }
      var lbx = backdrop.querySelector('.lightbox-carousel');
      if (lbx) {
        lbx.addEventListener('click', function(e) {
          var card = e.target.closest('.lightbox-prev, .lightbox-next');
          if (card) { lightboxIdx = parseInt(card.getAttribute('data-index') || '0', 10); updateLightbox(); }
        });
        lbx.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            var card = e.target.closest('.lightbox-prev, .lightbox-next');
            if (card) { e.preventDefault(); lightboxIdx = parseInt(card.getAttribute('data-index') || '0', 10); updateLightbox(); }
          }
        });
      }
    }

    document.addEventListener('keydown', function esc(e) {
      if (e.key === 'Escape' && lightboxOpen) { closeLightbox(); document.removeEventListener('keydown', esc); }
    });
  });
</script>

<section class="testimonials-section bg-default">
  <div class="testimonials-container">
    <h2 class="testimonials-title">How Partners Review Us</h2>
    <div id="testimonial-carousel" class="carousel" aria-label="Client testimonials carousel" role="region">
      <div class="card card-prev" data-index={prev0} role="button" tabindex="0" aria-label={'View testimonial: ' + TESTIMONIALS[prev0].alt}>
        <div class="card-inner">
          <img class="testimonial-image" alt={TESTIMONIALS[prev0].alt} src={TESTIMONIALS[prev0].src} loading="lazy" />
        </div>
      </div>
      <div class="card card-center" data-index="0" role="button" tabindex="0" aria-label={'View testimonial: ' + TESTIMONIALS[0].alt}>
        <div class="card-inner">
          <img class="testimonial-image" alt={TESTIMONIALS[0].alt} src={TESTIMONIALS[0].src} loading="lazy" />
        </div>
      </div>
      <div class="card card-next" data-index={next0} role="button" tabindex="0" aria-label={'View testimonial: ' + TESTIMONIALS[next0].alt}>
        <div class="card-inner">
          <img class="testimonial-image" alt={TESTIMONIALS[next0].alt} src={TESTIMONIALS[next0].src} loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>

<div id="testimonial-lightbox" class="lightbox-backdrop" style="display:none" role="dialog" aria-modal="true" aria-label="Testimonial lightbox">
  <div class="lightbox-content">
    <button id="lightbox-close-btn" class="lightbox-close" aria-label="Close lightbox">&times;</button>
    <div class="lightbox-carousel">
      <div class="card card-prev lightbox-prev" data-index={prev0} role="button" tabindex="0" aria-label={'View previous testimonial: ' + TESTIMONIALS[prev0].alt}>
        <div class="card-inner lightbox-crop">
          <img class="testimonial-image" alt={TESTIMONIALS[prev0].alt} src={TESTIMONIALS[prev0].src} loading="lazy" />
        </div>
      </div>
      <div class="card card-center lightbox-center-card" data-index="0" role="button" tabindex="0" aria-label={'View testimonial: ' + TESTIMONIALS[0].alt}>
        <div class="card-inner lightbox-full">
          <img class="testimonial-image testimonial-full" alt={TESTIMONIALS[0].alt} src={TESTIMONIALS[0].src} />
        </div>
      </div>
      <div class="card card-next lightbox-next" data-index={next0} role="button" tabindex="0" aria-label={'View next testimonial: ' + TESTIMONIALS[next0].alt}>
        <div class="card-inner lightbox-crop">
          <img class="testimonial-image" alt={TESTIMONIALS[next0].alt} src={TESTIMONIALS[next0].src} loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .testimonials-section { padding-block: var(--space-8); }
  .testimonials-container { max-width: 1200px; margin-inline: auto; padding-inline: var(--space-4); }
  .testimonials-title {
    font-family: var(--font-primary); font-weight: 900;
    font-variation-settings: "SOFT" 100; font-size: var(--text-h2);
    line-height: 1.2; color: var(--color-text); margin: 0 0 var(--space-6);
  }

  .carousel { display: flex; align-items: center; justify-content: center; position: relative; overflow: visible; }

  .card {
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: 4px; cursor: pointer; outline: none; flex: 0 0 auto;
    transition: opacity 200ms ease, transform 300ms ease;
    will-change: opacity, transform;
  }
  .card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .card-inner { overflow: hidden; border-radius: 2px; display: block; height: 121px; }
  .testimonial-image { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }

  .card-prev, .card-next { width: 260px; }
  .card-center { width: 290px; }
  .card-prev, .card-next { opacity: 0.5; transform: scale(0.88); }
  .card-center { opacity: 1; transform: scale(1); }

  @media (max-width: 767px) {
    .testimonials-section { padding-block: var(--space-6); }
    .testimonials-container { padding-inline: var(--space-3); }
    .card-prev, .card-next { width: 200px; }
    .card-center { width: 240px; }
    .card-inner { height: 85px; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .testimonials-section { padding-block: var(--space-10); }
  }
  @media (min-width: 1024px) {
    .testimonials-section { padding-block: var(--space-16); }
    .testimonials-container { padding-inline: var(--space-12); }
    .card-prev, .card-next { width: 300px; }
    .card-center { width: 340px; }
    .card-inner { height: 121px; }
  }

  /* ── Lightbox ── */
  .lightbox-backdrop {
    position: fixed; inset: 0; z-index: 1000;
    background-color: rgba(20, 20, 18, 0.92);
    display: flex; align-items: center; justify-content: center;
    padding: var(--space-6); animation: lightbox-fade-in 250ms ease forwards;
  }
  @keyframes lightbox-fade-in { from { opacity: 0; } to { opacity: 1; } }
  .lightbox-content { position: relative; width: 100%; max-width: 1400px; height: 100%; display: flex; align-items: center; }
  .lightbox-close {
    position: fixed; top: var(--space-4); right: var(--space-4); z-index: 1001;
    background: rgba(41, 43, 42, 0.85); border: 1px solid var(--color-border);
    color: var(--color-text); font-size: 1.5rem; width: 40px; height: 40px;
    border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .lightbox-close:hover { background: rgba(41, 43, 42, 1); border-color: var(--color-border-strong); }
  .lightbox-carousel { display: flex; align-items: center; justify-content: center; gap: 0; width: 100%; }
  .lightbox-carousel .card-prev,
  .lightbox-carousel .card-next { opacity: 0.5; transform: scale(0.88); }
  .lightbox-carousel .card-center { opacity: 1; transform: scale(1); }
  .lightbox-carousel .lightbox-crop { height: 180px; }
  .lightbox-carousel .card-center .lightbox-full { height: auto; display: block; }
  .lightbox-carousel .testimonial-full { object-fit: contain; object-position: top; max-height: 80vh; width: auto; display: block; margin: 0 auto; }

  @media (max-width: 767px) {
    .lightbox-backdrop { padding: var(--space-3); }
    .lightbox-carousel .lightbox-crop { height: 130px; }
    .lightbox-carousel .card-prev, .lightbox-carousel .card-next { width: 140px; }
    .lightbox-carousel .card-center { width: 180px; }
  }
  @media (min-width: 1024px) {
    .lightbox-carousel .lightbox-crop { height: 180px; }
    .lightbox-carousel .card-prev, .lightbox-carousel .card-next { width: 300px; }
    .lightbox-carousel .card-center { width: 340px; }
  }
</style>
