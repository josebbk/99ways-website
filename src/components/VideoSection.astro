---
// Video section — "How I Find CRO Breakthroughs Again and Again"
// Per design.md §6 (bg-alt), HOMEPAGE_SPEC.md §3
---

<section class="video-section bg-alt">
  <div class="video-container">
    <h2 class="video-title">How I Find CRO Breakthroughs Again and Again</h2>
    <div class="video-wrapper">
      <iframe
        src="https://www.youtube.com/embed/STouQwJZ4bY"
        title="How I Find CRO Breakthroughs Again and Again"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .video-section {
    padding-block: var(--space-8);
  }

  .video-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .video-title {
    font-family: var(--font-primary);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: var(--text-h2);
    line-height: 1.2;
    color: var(--color-text);
    margin: 0 0 var(--space-6);
    text-align: center;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    border: 1px solid var(--color-accent);
    border-radius: 4px;
    overflow: hidden;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  @media (min-width: 1024px) {
    .video-section {
      padding-block: var(--space-16);
    }

    .video-container {
      padding-inline: var(--space-12);
    }
  }
</style>
