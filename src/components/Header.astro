---
// Header — sticky, mobile-first responsive nav
// Mobile (< 768px): compact mark + hamburger menu
// Desktop (>= 768px): full wordmark + inline nav
// Per design.md §4, HOMEPAGE_SPEC.md §1

const navItems = [
  {
    label: 'Services',
    type: 'dropdown',
    children: [
      { label: 'Conversion Rate Optimization', href: '/hire-cro-expert/' },
      { label: 'PostHog & Product Analytics', href: '/hire-posthog-expert-guide/' },
      { label: 'Hyros & Tracking Setup', href: '/hire-hyros-expert-guide/' },
    ],
  },
  {
    label: 'Resources',
    type: 'dropdown',
    children: [
      { label: 'Guides and How-tos', href: '/category/guides-how-to/' },
      { label: 'PostHog Feature Breakdowns', href: '/category/posthog-feature-breakdown/' },
      { label: 'Tools Comparison', href: '/category/tools-comparison/' },
      {
        label: 'Optimization Experiences',
        href: '/category/optimization-experience/',
        splitArrow: true,
        children: [
          { label: 'Featured Experiments', href: '/category/optimization-experience/featured-experiments/' },
        ],
      },
    ],
  },
];

const wordmarkSrc = '/assets/logo/wordmark/dark/99ways-wordmark-dark-background.svg';
const compactSrc = '/assets/logo/compact/dark/99ways-compact-dark-background.svg';
---

<header class="header bg-default">
  <div class="header-container">
    <a href="/" class="header-logo" aria-label="99Ways home">
      <img class="header-wordmark" src={wordmarkSrc} alt="99Ways" width="180" height="51" />
      <img class="header-compact" src={compactSrc} alt="99Ways" width="64" height="44" />
    </a>

    <button class="header-toggle" aria-label="Toggle navigation" aria-expanded="false">
      <span class="hamburger"></span>
      <span class="hamburger"></span>
      <span class="hamburger"></span>
    </button>

    <nav class="header-nav" aria-label="Main navigation">
      <ul class="nav-list">
        {navItems.map(item => (
          <li class="nav-item dropdown">
            <button class="nav-link dropdown-toggle" aria-haspopup="true" aria-expanded="false" data-dropdown>
              {item.label}
              <svg class="dropdown-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <ul class="dropdown-menu" role="menu">
              {item.children.map(child => (
                <li role="none">
                  <a class="dropdown-link nav-split-link" href={child.href} role="menuitem" data-submenu={child.children ? '' : undefined}>
                    {child.label}
                    {child.splitArrow && (
                      <button class="dropdown-submenu-arrow" type="button" aria-label="Toggle Featured Experiments" data-submenu-arrow>
                        <span class="arrow-desktop">&gt;</span>
                        <span class="arrow-mobile">▾</span>
                      </button>
                    )}
                  </a>
                  {child.children && (
                    <ul class="dropdown-submenu" role="menu">
                      {child.children.map(sub => (
                        <li role="none">
                          <a class="dropdown-submenu-link" href={sub.href} role="menuitem">{sub.label}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <a href="/contact-form/" class="btn-ghost header-cta">Contact Us</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    border-bottom: 1px solid var(--color-border);
  }

  .header-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    align-items: center;
    height: 72px;
    gap: var(--space-6);
  }

  .header-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .header-wordmark {
    display: block;
    width: 180px;
    min-width: 180px;
    height: auto;
  }

  .header-compact {
    display: none;
    width: 64px;
    min-width: 64px;
    height: auto;
  }

  .header-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
    margin-left: auto;
  }

  .hamburger {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text);
    border-radius: 1px;
    transition: background-color 150ms ease;
  }

  .header-nav {
    display: none;
  }

  /* Mobile nav when toggled open */
  .header-nav.open {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) var(--space-4) var(--space-6);
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-3) 0;
    background: none;
    border: none;
    color: var(--color-text);
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: var(--text-label);
    line-height: 1.4;
    letter-spacing: 0.02em;
    cursor: default;
    text-decoration: none;
    transition: color 150ms ease;
    width: 100%;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .dropdown-chevron {
    width: 10px;
    height: 6px;
    transition: transform 150ms ease;
  }

  .dropdown-toggle[aria-expanded="true"] .dropdown-chevron {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: none;
    flex-direction: column;
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    margin-top: var(--space-2);
    padding: var(--space-2) 0;
  }

  .dropdown-toggle[aria-expanded="true"] + .dropdown-menu {
    display: flex;
  }

  .dropdown-link,
  .dropdown-submenu-link {
    display: block;
    padding: var(--space-2) var(--space-4);
    color: var(--color-text);
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: var(--text-label);
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .dropdown-link:hover,
  .dropdown-submenu-link:hover {
    color: var(--color-accent);
  }

  .dropdown-submenu {
    list-style: none;
    margin: 0;
    padding: 0;
    padding-left: var(--space-4);
  }

  .dropdown-submenu.submenu-open {
    display: flex;
  }

  .header-cta {
    margin-top: var(--space-4);
  }

  @media (min-width: 768px) {
    .header-container {
      padding-inline: var(--space-12);
      height: 80px;
    }

    .header-toggle {
      display: none;
    }

    .header-wordmark {
      display: block;
    }

    .header-compact {
      display: none;
    }

    .header-nav {
      display: flex !important;
      flex-direction: row;
      align-items: center;
      position: static;
      background: none;
      border: none;
      padding: 0;
      margin-left: auto;
      gap: var(--space-6);
    }

    .nav-list {
      flex-direction: row;
      gap: var(--space-2);
      align-items: center;
    }

    .nav-item {
      position: relative;
    }

    .nav-link {
      font-family: var(--font-brand);
      font-weight: 500;
      font-size: var(--text-label);
      line-height: 1.4;
      letter-spacing: 0.02em;
      padding: var(--space-2) var(--space-3);
      border-radius: 2px;
      cursor: default;
    }

    .dropdown-menu {
      position: absolute;
      top: 100%;
      left: 0;
      margin-top: 0;
      min-width: 240px;
      z-index: 101;
    }

    .dropdown-toggle[aria-expanded="true"] + .dropdown-menu {
      display: flex;
    }

    /* Desktop: hide chevron on top-level triggers */
    .dropdown-chevron {
      display: none;
    }

    /* Desktop: hide submenus by default, reveal on parent hover */
    .dropdown-submenu {
      display: none;
    }

    .dropdown-link:hover + .dropdown-submenu {
      display: flex;
    }

    /* Desktop: split link text has no pointer cursor */
    .nav-split-link {
      cursor: default;
    }

    /* Desktop: arrow indicator visible, purely visual, matches menu font/color */
    .dropdown-submenu-arrow {
      display: flex;
      cursor: default;
      width: auto;
      height: auto;
      background: none;
      border: none;
      padding: 0;
      color: var(--color-text);
      font-family: var(--font-brand);
      font-size: var(--text-label);
      line-height: 1;
    }

    .dropdown-submenu-arrow:hover {
      color: var(--color-accent);
    }

    .arrow-desktop { display: inline; }
    .arrow-mobile { display: none; }

    .header-cta {
      margin-top: 0;
    }
  }

  @media (max-width: 767px) {
    .header-wordmark {
      display: none;
    }

    .header-compact {
      display: block;
    }

    /* Mobile: split link is a flex row — text navigates, arrow toggles */
    .nav-split-link {
      display: flex;
      align-items: center;
      cursor: default;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
    }

    /* Mobile: arrow button — separate tap target */
    .dropdown-submenu-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      color: var(--color-text-muted);
      font-family: var(--font-brand);
      font-size: var(--text-label);
      line-height: 1;
      transition: color 150ms ease;
    }

    .dropdown-submenu-arrow:hover {
      color: var(--color-accent);
    }

    .dropdown-submenu-arrow:active {
      color: var(--color-accent);
    }

    .arrow-desktop { display: none; }
    .arrow-mobile { display: inline; }

    /* Mobile: submenu margin for indentation */
    .dropdown-submenu {
      margin-top: var(--space-1);
      padding-left: var(--space-3);
    }
  }
</style>

<script>
  const toggle = document.querySelector('.header-toggle');
  const nav = document.querySelector('.header-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // Mobile/tablet: accordion behavior — click toggles, one open at a time
  document.querySelectorAll('.dropdown-toggle[data-dropdown]').forEach(toggleBtn => {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';

      // Close all other dropdowns immediately
      document.querySelectorAll('.dropdown-toggle[data-dropdown]').forEach(other => {
        if (other !== toggleBtn) {
          other.setAttribute('aria-expanded', 'false');
        }
      });

      // Toggle current
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
    });
  });

  // Mobile: split tap target for "Optimization Experiences" — arrow toggles, text navigates
  document.querySelectorAll('[data-submenu-arrow]').forEach(arrow => {
    arrow.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!isMobile()) return;
      // Toggle submenu directly
      const link = arrow.closest('.dropdown-link[data-submenu]');
      if (!link) return;
      const arrowSibling = arrow.nextElementSibling;
      const submenu = arrowSibling?.classList.contains('dropdown-submenu')
        ? arrowSibling
        : findSubmenuSibling(link);
      if (submenu?.classList.contains('dropdown-submenu')) {
        submenu.classList.toggle('submenu-open');
      }
    });
  });

  function findSubmenuSibling(link) {
    // Skip over arrow button to find the submenu
    let el = link.nextElementSibling;
    if (el?.hasAttribute('data-submenu-arrow')) {
      el = el.nextElementSibling;
    }
    if (el?.classList.contains('dropdown-submenu')) return el;
    // Fallback: continue searching
    while (el) {
      if (el.classList.contains('dropdown-submenu')) return el;
      el = el.nextElementSibling;
    }
    return null;
  }

  // Desktop (>= 768px): hover-triggered dropdowns with smart close timing
  // — immediate close when switching to a different trigger
  // — 175ms delay only when leaving toward own menu content
  const isMobile = () => window.matchMedia('(max-width: 767px)').matches;
  let activeMenu = null;

  const desktopEventMap = new Map();

  document.querySelectorAll('.dropdown-toggle[data-dropdown]').forEach(toggleBtn => {
    const menu = toggleBtn.nextElementSibling;
    if (!menu?.classList.contains('dropdown-menu')) return;
    if (isMobile()) return;

    desktopEventMap.set(toggleBtn, { menu, isTrigger: true });
    desktopEventMap.set(menu, { menu, isTrigger: false });

    menu.addEventListener('mouseenter', () => showMenu(menu));
    menu.addEventListener('mouseleave', () => scheduleClose(menu));
  });

  document.addEventListener('mouseover', (e) => {
    if (isMobile()) return;
    const info = desktopEventMap.get(e.target);
    if (!info) return;

    if (info.isTrigger) {
      // Entering a trigger: close previous menu immediately (not a different menu staying open)
      if (activeMenu && activeMenu !== info.menu) {
        activeMenu.style.display = 'none';
      }
      activeMenu = info.menu;
      showMenu(info.menu);
    } else {
      // Entering/leaving a menu
      showMenu(info.menu);
    }
  });

  document.addEventListener('mouseout', (e) => {
    if (isMobile()) return;
    const related = e.relatedTarget;
    const info = desktopEventMap.get(e.target);
    if (!info) return;
    // Only act on events from within our tracked elements
    if (!desktopEventMap.has(related)) return;

    if (!info.isTrigger && e.relatedTarget && !info.menu.contains(e.relatedTarget)) {
      scheduleClose(info.menu);
    }
  });

  function showMenu(menu) {
    clearTimeout(menu._closeTimer);
    menu._closeTimer = null;
    menu.style.display = 'flex';
  }

  function scheduleClose(menu) {
    clearTimeout(menu._closeTimer);
    menu._closeTimer = setTimeout(() => {
      menu.style.display = 'none';
      menu._closeTimer = null;
      if (activeMenu === menu) activeMenu = null;
    }, 175);
  }

  // Desktop: "Optimization Experiences" nested submenu hover reveal
  document.querySelectorAll('.dropdown-link[data-submenu]').forEach(parentLink => {
    const arrow = parentLink.querySelector('[data-submenu-arrow]');
    const afterArrow = arrow ? arrow.nextElementSibling : parentLink.nextElementSibling;
    const submenu = afterArrow?.classList.contains('dropdown-submenu') ? afterArrow : findSubmenuSibling(parentLink);
    if (!submenu?.classList.contains('dropdown-submenu')) return;
    if (isMobile()) return;

    let closeTimer = null;

    function showSubmenu() {
      clearTimeout(closeTimer);
      closeTimer = null;
      submenu.style.display = 'flex';
    }

    function scheduleClose() {
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        submenu.style.display = 'none';
        closeTimer = null;
      }, 175);
    }

    parentLink.addEventListener('mouseenter', showSubmenu);
    parentLink.addEventListener('mouseleave', scheduleClose);
    submenu.addEventListener('mouseenter', showSubmenu);
    submenu.addEventListener('mouseleave', scheduleClose);
  });

  // Close mobile nav when clicking a dropdown link (not the submenu toggle)
  nav?.querySelectorAll('.dropdown-link:not([data-submenu])').forEach(link => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
