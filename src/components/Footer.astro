---
// Footer — compact mark, three link columns, social icons, legal, copyright
// Per design.md §6 (bg-default), HOMEPAGE_SPEC.md §8
// No Google Maps embed — text link only, as specified

const compactLogoSrc = '/assets/logo/compact/dark/99ways-compact-dark-background.svg';

const resourcesLinks = [
  { label: 'Guides and How-tos', href: '/category/guides-how-to/' },
  { label: 'PostHog Feature Breakdowns', href: '/category/posthog-feature-breakdown/' },
  { label: 'Tools Comparison', href: '/category/tools-comparison/' },
  { label: 'Optimization Experiences', href: '/category/optimization-experience/' },
  { label: 'Featured Experiments', href: '/category/optimization-experience/featured-experiments/' },
];

const servicesLinks = [
  { label: 'PostHog & Product Analytics', href: '/hire-posthog-expert-guide/' },
  { label: 'Hyros & Tracking Setup', href: '/hire-hyros-expert-guide/' },
  { label: 'CRO', href: '/hire-cro-expert/' },
];

const aboutLinks = [
  { label: 'Contact Us', href: '/contact-form/' },
  { label: "Iman's Upwork", href: 'https://www.upwork.com/freelancers/imannazari', external: true },
  { label: "Agency's Upwork", href: 'https://www.upwork.com/agencies/1718792436665155584/', external: true },
  { label: 'Fiverr', href: 'https://www.fiverr.com/ishto7', external: true },
  { label: 'GitHub', href: 'https://github.com/99ways-io', external: true },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/99ways-io/', external: true },
  { label: 'Medium', href: 'https://medium.com/nes-stories', external: true },
  { label: 'Google Maps', href: 'https://maps.app.goo.gl/daoBjTCZu7YghnJj9', external: true },
];

const socialLinks = [
  { href: 'https://www.linkedin.com/company/99ways-io/', label: 'LinkedIn', icon: 'linkedin' },
  { href: 'https://www.upwork.com/freelancers/imannazari', label: "Iman's Upwork", icon: 'upwork' },
  { href: 'https://www.upwork.com/agencies/1718792436665155584/', label: "Agency's Upwork", icon: 'upwork' },
  { href: 'https://www.fiverr.com/ishto7', label: 'Fiverr', icon: 'fiverr' },
  { href: 'https://github.com/99ways-io', label: 'GitHub', icon: 'github' },
  { href: 'https://medium.com/nes-stories', label: 'Medium', icon: 'medium' },
];

function socialIcon(type) {
  switch (type) {
    case 'linkedin':
      return `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H4V9h4v10zM6 8.7A2.3 2.3 0 116 4.1a2.3 2.3 0 010 4.6zM19 19h-4v-5.5c0-1.9-2.5-1.6-2.5 0V19h-4V9h4v1.7c.7-1.2 3.5-1.4 4.5 0V19z"/></svg>`;
    case 'upwork':
      return `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.8 5.5c0-1.2-.9-1.9-2-1.9-.8 0-1.5.5-1.8 1.2L12 3.5l-1 .7c-.3-.7-1-1.2-1.8-1.2-1.1 0-2 .7-2 1.9 0 1.6 1.6 3.6 3.8 5.4 1.6 1.3 2.1 2.1 2.1 3 0 .7-.5 1.2-1.2 1.2-.9 0-1.7-.8-2.2-1.8l-1.8 1c.8 1.8 2.5 3.1 4.5 3.1 2.3 0 3.8-1.5 3.8-3.5 0-2.2-2.2-4.2-4.2-5.8-1.3-1.1-2-2-2-2.9 0-.5.3-.9.8-.9.7 0 1.3.6 1.6 1.4L12 5.8l1-.7c.3.7.9 1.4 1.8 1.4 1.1 0 2-.7 2-1.9V5.5z"/></svg>`;
    case 'fiverr':
      return `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.6 3.4L9 20.6 4.4 13l2.1-1.5L9 16.3 16.8 3.4H18.6zM7.3 2h2.1L6.2 8 4.1 6.5 7.3 2zm4.8 0h2.1l-3.2 6-2.1-1.5L12.1 2z"/></svg>`;
    case 'github':
      return `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"/></svg>`;
    case 'medium':
      return `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 4H2v16h20V4zM6.1 18.5c-.6 0-1.1-.5-1.1-1.1s.5-1.1 1.1-1.1 1.1.5 1.1 1.1-.5 1.1-1.1 1.1zm5.9 0c-.7 0-1.2-.5-1.2-1.2V11h1.3v6.3h1.6v-3.7c0-1.3-1.4-1.5-1.7 0h-1.6c.1-2.6 1.7-4.1 4.2-4.1 2.2 0 3.3 1.4 3.3 3.5v4.3h-1.4v-.4c-.7 1-2.1 1.5-3.4 1.5-1.7 0-2.6-1-2.6-2.5V11h-1.3v6.3h1.6v-3.7c0-1.3-1.4-1.5-1.7 0H9.9c.1-2.6 1.7-4.1 4.2-4.1 2.2 0 3.3 1.4 3.3 3.5v4.3h-1.4v-.4c-.7 1-2.1 1.5-3.4 1.5-1.7 0-2.6-1-2.6-2.5z"/></svg>`;
    default:
      return '';
  }
}
---

<footer class="footer bg-default">
  <div class="footer-container">
    <a href="/" class="footer-logo" aria-label="99Ways home">
      <img src={compactLogoSrc} alt="99Ways" width="64" height="44" />
    </a>

    <div class="footer-columns">
      <div class="footer-column">
        <h3 class="footer-heading">Resources</h3>
        <ul class="footer-links">
          {resourcesLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-column">
        <h3 class="footer-heading">Services</h3>
        <ul class="footer-links">
          {servicesLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-column">
        <h3 class="footer-heading">About Us</h3>
        <ul class="footer-links">
          {aboutLinks.map(link => (
            <li><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-social">
      {socialLinks.map(link => (
        <a href={link.href} class="social-link" aria-label={link.label} target="_blank" rel="noopener noreferrer">
          <span set:html={socialIcon(link.icon)} />
        </a>
      ))}
    </div>

    <p class="footer-legal">
      <em>Ninety Nine Ways</em> is a registered trademark of Nazari Ecom Solutions. Nazari Ecom Solutions is registered with the Dutch Chamber of Commerce (KvK) under registration number 91552451. Office: Mr. Treublaan 7, 1097 DP Amsterdam, The Netherlands. VAT Identification Number: NL004899587B87.
    </p>

    <p class="footer-copyright">
      2025 99Ways | All right reserved.
      <a href="/privacy-policy/" class="footer-legal-link">Privacy Policy</a>
      <span class="footer-divider">|</span>
      <a href="/terms-of-use/" class="footer-legal-link">Terms of Service</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-12);
  }

  .footer-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-logo {
    display: block;
    margin-bottom: var(--space-8);
  }

  .footer-logo img {
    width: 64px;
    min-width: 64px;
    height: auto;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    width: 100%;
    margin-bottom: var(--space-8);
  }

  .footer-heading {
    font-family: var(--font-primary);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: var(--text-h3);
    line-height: 1.3;
    color: var(--color-text);
    margin: 0 0 var(--space-4);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-links a {
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
    transition: color 150ms ease;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: color 150ms ease;
    width: 36px;
    height: 36px;
    border-radius: 4px;
  }

  .social-link:hover {
    color: var(--color-accent);
  }

  .footer-legal {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
    max-width: 720px;
  }

  .footer-copyright {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: center;
  }

  .footer-legal-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-legal-link:hover {
    color: var(--color-accent);
  }

  .footer-divider {
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .footer {
      padding-block: var(--space-16);
    }

    .footer-container {
      padding-inline: var(--space-12);
    }

    .footer-columns {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }

    .footer-container {
      align-items: flex-start;
    }

    .footer-social {
      gap: var(--space-3);
    }
  }

  @media (min-width: 1024px) {
    .footer-columns {
      gap: var(--space-12);
    }
  }
</style>
