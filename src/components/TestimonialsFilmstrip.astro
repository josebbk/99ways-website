---
// Testimonials filmstrip — horizontally-scrolling carousel
// Per design.md §6 (bg-default), §5 (card with section bg), HOMEPAGE_SPEC.md §4
// 9 cards, momentum/snap scroll, native aspect ratio images

import Card from './Card.astro';

const testimonials = [
  {
    src: '/images/testimonials/01-funnel-optimization.webp',
    alt: 'Client review: Funnel Optimization Assessment and Recommendations',
  },
  {
    src: '/images/testimonials/02-ecommerce-analytics-cro.webp',
    alt: 'Client review: E-commerce analytics, CRO, and A/B testing',
  },
  {
    src: '/images/testimonials/03-marketing-cro-consultation.webp',
    alt: 'Client review: Marketing and conversion rate optimization consultation',
  },
  {
    src: '/images/testimonials/04-cro-quick-job.webp',
    alt: 'Client review: Conversion Rate Optimization Expert quick job',
  },
  {
    src: '/images/testimonials/05-posthog-analytics.webp',
    alt: 'Client review: PostHog and Analytics Expert',
  },
  {
    src: '/images/testimonials/06-cro-coaching-business.webp',
    alt: 'Client review: Conversion Rate Optimization for Coaching Business',
  },
  {
    src: '/images/testimonials/07-cro-posthog.webp',
    alt: 'Client review: Conversion Rate Optimization and PostHog',
  },
  {
    src: '/images/testimonials/08-course-marketing-funnel.webp',
    alt: 'Client review: Course Marketing Funnel Manager',
  },
  {
    src: '/images/testimonials/09-saas-posthog-setup.webp',
    alt: 'Client review: SaaS Google Analytics and PostHog setup',
  },
];
---

<section class="testimonials-section bg-default">
  <div class="testimonials-container">
    <h2 class="testimonials-title">How Partners Review Us</h2>
    <div class="testimonials-filmstrip">
      {testimonials.map(t => (
        <Card style="--card-bg: var(--color-bg);">
          <img
            src={t.src}
            alt={t.alt}
            loading="lazy"
            class="testimonial-image"
          />
        </Card>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    padding-block: var(--space-8);
  }

  .testimonials-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .testimonials-title {
    font-family: var(--font-primary);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: var(--text-h2);
    line-height: 1.2;
    color: var(--color-text);
    margin: 0 0 var(--space-6);
  }

  .testimonials-filmstrip {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: var(--space-2);
    scrollbar-width: thin;
    scrollbar-color: var(--color-text-muted) transparent;
  }

  .testimonials-filmstrip::-webkit-scrollbar {
    height: 6px;
  }

  .testimonials-filmstrip::-webkit-scrollbar-track {
    background: transparent;
  }

  .testimonials-filmstrip::-webkit-scrollbar-thumb {
    background-color: var(--color-text-muted);
    border-radius: 3px;
  }

  .testimonials-filmstrip > * {
    flex: 0 0 auto;
    scroll-snap-align: start;
    min-width: 280px;
    max-width: 360px;
  }

  .testimonial-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }

  @media (min-width: 1024px) {
    .testimonials-section {
      padding-block: var(--space-16);
    }

    .testimonials-container {
      padding-inline: var(--space-12);
    }

    .testimonials-filmstrip > * {
      min-width: 320px;
      max-width: 400px;
    }
  }
</style>
