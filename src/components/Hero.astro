---
// Hero — fully centered single column, text + CTA only
// Decorative Logo Field mounted behind content per design.md §5, HOMEPAGE_SPEC.md §2
import DecorativeLogoField from './DecorativeLogoField.astro';

const headline = 'Find and Pull Your Biggest Growth Levers with Experimentation';
const subhead = 'We run your CRO operation, from research and prioritization to implementation and analysis.';
---

<section class="hero bg-default">
  <DecorativeLogoField />
  <div class="hero-container">
    <h1 class="hero-headline">{headline}</h1>
    <p class="hero-subhead">{subhead}</p>
    <a href="#" class="btn-primary">Book Intro Call</a>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .hero-headline {
    font-family: var(--font-primary);
    font-weight: 900;
    font-variation-settings: "SOFT" 100;
    font-size: var(--text-display);
    line-height: 1.15;
    color: var(--color-text);
    margin: 0;
  }

  .hero-subhead {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 640px;
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--space-16);
    }
  }
</style>
