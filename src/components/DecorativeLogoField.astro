---
// Decorative Logo Field — atmospheric background texture of scattered logo instances
// Per design.md §5 (Components), §4 (scoped exception), §6 (section backgrounds)
// HOMEPAGE_SPEC.md §2 (Hero application)
const {
  assetPath = '/icons/micro/99ways-compact-micro-32px-dark-background-2x.png',
  // Per-tier instance counts
  mobileCount = 10,
  tabletCount = 18,
  desktopCount = 30,
  // Per-tier size ranges (px) — smaller instances at small viewports
  // to prevent large instances from bleeding into the protected zone
  mobileSizeMin = 24,
  mobileSizeMax = 64,
  tabletSizeMin = 24,
  tabletSizeMax = 96,
  desktopSizeMin = 24,
  desktopSizeMax = 180,
  // Opacity range
  opacityMin = 0.04,
  opacityMax = 0.18,
  // Rotation range
  rotationMax = 25,
  // Per-tier protected zone widths (%)
  // Calculated so the remaining edge area is wide enough for the largest instance at that tier
  mobileProtectedWidth = 70,   // 15% edge strips each side (375px * 0.15 = 56px > max 64px/2)
  tabletProtectedWidth = 60,   // 20% edge strips each side (768px * 0.2 = 154px > max 96px/2)
  desktopProtectedWidth = 45,  // 27.5% edge strips each side (1280px * 0.275 = 352px > max 180px/2)
} = Astro.props;

// Seeded PRNG (Mulberry32) — deterministic per build, no client JS needed
let _seed = 0;
function mulberry32(s) {
  _seed = s;
  return function () {
    _seed += 0x6d2b79f5;
    let t = Math.imul(_seed ^ (_seed >>> 15), 1 | _seed);
    t ^= t + Math.imul(t ^ (t >>> 7), 61 | t);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function rand(lo, hi, r) {
  return lo + r() * (hi - lo);
}

function generateInstances(count, protectedWidth, tierSizeMax, seed) {
  _seed = seed;
  const r = mulberry32(seed);
  const pMin = protectedWidth / 2;
  const pMax = 100 - pMin;
  const out = [];

  for (let i = 0; i < count; i++) {
    for (let attempt = 0; attempt < 1000; attempt++) {
      const x = rand(0, 100, r);
      const y = rand(0, 100, r);
      const size = rand(24, tierSizeMax, r);

      // Clearance: instance half-width as % of a 1280px reference container
      // This ensures the protected zone boundary is never crossed,
      // even on the largest possible container.
      const halfWidthPct = (size / 2) / 1280 * 100;

      if (x + halfWidthPct < pMin || x - halfWidthPct > pMax) {
        out.push({
          x,
          y,
          size,
          opacity: rand(opacityMin, opacityMax, r),
          rotation: rand(-rotationMax, rotationMax, r),
        });
        break;
      }
    }
  }
  return out;
}

const mobileInstances = generateInstances(mobileCount, mobileProtectedWidth, mobileSizeMax, 42);
const tabletInstances = generateInstances(tabletCount, tabletProtectedWidth, tabletSizeMax, 137);
const desktopInstances = generateInstances(desktopCount, desktopProtectedWidth, desktopSizeMax, 999);

---

<div class="logo-field-wrapper" aria-hidden="true">
  {mobileInstances.map(inst => (
    <img
      src={assetPath}
      alt=""
      class="logo-instance tier-mobile"
      style={`
        position: absolute;
        left: ${inst.x}%;
        top: ${inst.y}%;
        width: ${inst.size}px;
        opacity: ${inst.opacity};
        transform: translate(-50%, -50%) rotate(${inst.rotation}deg);
      `}
    />
  ))}
  {tabletInstances.map(inst => (
    <img
      src={assetPath}
      alt=""
      class="logo-instance tier-tablet"
      style={`
        position: absolute;
        left: ${inst.x}%;
        top: ${inst.y}%;
        width: ${inst.size}px;
        opacity: ${inst.opacity};
        transform: translate(-50%, -50%) rotate(${inst.rotation}deg);
      `}
    />
  ))}
  {desktopInstances.map(inst => (
    <img
      src={assetPath}
      alt=""
      class="logo-instance tier-desktop"
      style={`
        position: absolute;
        left: ${inst.x}%;
        top: ${inst.y}%;
        width: ${inst.size}px;
        opacity: ${inst.opacity};
        transform: translate(-50%, -50%) rotate(${inst.rotation}deg);
      `}
    />
  ))}
</div>

<style is:global>
  .logo-field-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  .logo-field-wrapper .logo-instance {
    width: 32px;
    height: auto;
  }

  /* Base state: all hidden — each breakpoint shows only its own tier */
  .logo-field-wrapper .logo-instance.tier-mobile,
  .logo-field-wrapper .logo-instance.tier-tablet,
  .logo-field-wrapper .logo-instance.tier-desktop {
    visibility: hidden;
  }

  /* Mobile (<768px): ~10 instances */
  @media (max-width: 767px) {
    .logo-field-wrapper .logo-instance.tier-mobile {
      visibility: visible;
    }
  }

  /* Tablet (768px–1023px): ~18 instances */
  @media (min-width: 768px) and (max-width: 1023px) {
    .logo-field-wrapper .logo-instance.tier-tablet {
      visibility: visible;
    }
  }

  /* Desktop (1024px+): ~30 instances */
  @media (min-width: 1024px) {
    .logo-field-wrapper .logo-instance.tier-desktop {
      visibility: visible;
    }
  }
</style>
